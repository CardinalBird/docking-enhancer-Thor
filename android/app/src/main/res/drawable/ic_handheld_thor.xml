<!-- The AYN Thor, opened, front on: lid with its screen, the hinge, and the deck with its small
     centre screen, a stick over the D-pad on the left, the face buttons over a stick on the right.
     One colour, white on purpose: callers tint it with the theme's secondary text colour, and the
     screens are the same ink at half strength. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="100dp"
    android:viewportWidth="120"
    android:viewportHeight="100">
    <!-- Lid -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3"
        android:pathData="M18,4 H102 A6,6 0 0 1 108,10 V40 A6,6 0 0 1 102,46 H18 A6,6 0 0 1 12,40 V10 A6,6 0 0 1 18,4 Z" />
    <path android:fillColor="#FFFFFFFF" android:fillAlpha="0.5"
        android:pathData="M20,10 H100 A2,2 0 0 1 102,12 V38 A2,2 0 0 1 100,40 H20 A2,2 0 0 1 18,38 V12 A2,2 0 0 1 20,10 Z" />
    <!-- Hinge: a solid band the full width of the body, flush with both outlines, so lid, hinge
         and deck read as one piece with no gaps -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M10.5,46.5 H109.5 V53.5 H10.5 Z" />



    <!-- Deck -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3"
        android:pathData="M18,54 H102 A6,6 0 0 1 108,60 V90 A6,6 0 0 1 102,96 H18 A6,6 0 0 1 12,90 V60 A6,6 0 0 1 18,54 Z" />
    <!-- Centre screen -->
    <path android:fillColor="#FFFFFFFF" android:fillAlpha="0.5"
        android:pathData="M48,60 H72 A2,2 0 0 1 74,62 V88 A2,2 0 0 1 72,90 H48 A2,2 0 0 1 46,88 V62 A2,2 0 0 1 48,60 Z" />
    <!-- Left stick, D-pad under it. Clear space between them, or at tile size they fuse into one glyph. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:pathData="M29,64.5 A6,6 0 1 1 28.99,64.5 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M29,62 A2.5,2.5 0 1 1 28.99,62 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M27.25,80.5 H30.75 V83.75 H34 V87.25 H30.75 V90.5 H27.25 V87.25 H24 V83.75 H27.25 Z" />
    <!-- Face buttons, right stick under them -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M91,60.5 A2.4,2.4 0 1 1 90.99,60.5 Z M96,65.5 A2.4,2.4 0 1 1 95.99,65.5 Z M91,70.5 A2.4,2.4 0 1 1 90.99,70.5 Z M86,65.5 A2.4,2.4 0 1 1 85.99,65.5 Z" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:pathData="M91,85.5 A6,6 0 1 1 90.99,85.5 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M91,83 A2.5,2.5 0 1 1 90.99,83 Z" />

</vector>
